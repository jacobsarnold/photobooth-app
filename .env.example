# Copy to .env.local and fill in. Add the same values in Vercel -> Project -> Settings -> Environment Variables.

# Supabase dashboard -> Project Settings -> API (or "Connect")
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# SERVER ONLY - never prefix with NEXT_PUBLIC_. Same page, "service_role" / secret key.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Guests need this code to upload (it is baked into the QR code link: /?code=...).
# Leave empty to let anyone with the link upload.
PARTY_CODE=party2026

# Printed on the photo frame and shown on the pages
NEXT_PUBLIC_PARTY_TITLE=Happy Birthday!
